// Modelo de dados da plataforma contábil.
// SQLite nesta fase; o mesmo schema migra para PostgreSQL trocando o provider.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Escritório contábil — dados institucionais e papel timbrado.
// ---------------------------------------------------------------------------
model Escritorio {
  id                String  @id @default(cuid())
  razaoSocial       String
  nomeFantasia      String?
  cnpj              String?
  crc               String?
  endereco          String?
  telefone          String?
  email             String?
  site              String?
  // Papel timbrado
  logoDataUrl       String? // imagem em data URL (base64)
  assinaturaDataUrl String?
  corPrimaria       String  @default("#1e3a5f")
  corSecundaria     String  @default("#2c7a7b")
  rodapePadrao      String?

  usuarios Usuario[]
  clientes Cliente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Usuários internos e clientes (papel define o nível de acesso).
// papel: ADMIN | CONTADOR | ANALISTA | CLIENTE
// ---------------------------------------------------------------------------
model Usuario {
  id        String  @id @default(cuid())
  nome      String
  email     String  @unique
  senhaHash String
  papel     String
  crc       String? // para o contador responsável
  ativo     Boolean @default(true)

  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])
  escritorioId String

  // Quando papel = CLIENTE, vincula ao Cliente correspondente.
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  clienteId String?

  aceiteTermos     Boolean   @default(false)
  aceiteTermosData DateTime?

  logs      LogAcesso[]
  createdAt DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Cliente (empresa analisada) — dados cadastrais e tributários.
// ---------------------------------------------------------------------------
model Cliente {
  id                  String  @id @default(cuid())
  razaoSocial         String
  nomeFantasia        String?
  cnpj                String
  inscricaoEstadual   String?
  inscricaoMunicipal  String?
  cnaePrincipal       String?
  regimeTributario    String? // Simples Nacional | Lucro Presumido | Lucro Real | MEI
  porte               String? // ME | EPP | Demais
  naturezaJuridica    String?
  municipio           String?
  uf                  String?
  setorAtividade      String? // comercio | industria | servico | rural | holding | construcao | outro
  atividadeTributaria String? // varejo | atacado | fabricante | importador — pra escolher aba correta da Econet
  responsavelLegal    String?
  contadorResponsavel String?
  crcContador         String?
  email               String?
  telefone            String?

  // ---- Acesso ao e-CAC via SERPRO (Auditoria Tributária) ----
  // A plataforma NÃO armazena o .pfx do certificado — só aponta e usa em runtime.
  // PROCURACAO_MARCH: usa cert do escritório + procuração eletrônica ativa em nome desse cliente.
  // CERTIFICADO_PROPRIO: o cliente tem cert dele; a plataforma lê do path informado com a senha cifrada.
  metodoAcessoEcac   String  @default("PROCURACAO_MARCH") // PROCURACAO_MARCH | CERTIFICADO_PROPRIO
  certificadoCaminho String? // path absoluto do .pfx (só quando CERTIFICADO_PROPRIO)
  certificadoSenha   String? // cifrada AES-256-GCM com chave em ENCRYPTION_KEY (env)

  // ---- Acesso ao Portal da SEFAZ-TO (GIAM) ----
  // Login por Inscrição Estadual (campo já existe acima) + senha. NÃO é certificado digital.
  // Usado pelo robô que raspa a ConsGIAM.Asp e busca DARE no Portal do Contribuinte.
  // Cifrada AES-256-GCM (mesmo padrão do certificadoSenha). Nunca volta pra tela nem log.
  senhaSefaz String? // cifrada AES-256-GCM com chave em ENCRYPTION_KEY (env)

  // ---- Pasta local onde ficam os arquivos fiscais do cliente ----
  // Path absoluto (rede ou local). A plataforma varre essa pasta pra achar SPEDs
  // e outros arquivos fiscais — NUNCA copia nem salva o conteúdo, só lê e extrai.
  // Ex.: Z:\MARCH - ARQUIVO DAS EMPRESAS\CLIENTE\FISCAL\DECLARAÇÕES
  pastaFiscal String?

  // Pasta COMPARTILHADA onde ficam as GIAMs (o Domínio salva todas as GIAMs de
  // todos os clientes num diretório único, tipo Z:\HIGOR OBRIGAÇÕES MENSAIS\GIAM\).
  // Se vazio, usa pastaFiscal. A varredura filtra por IE dentro do arquivo pra
  // pegar só os que são deste cliente.
  pastaGiam String?

  escritorio   Escritorio @relation(fields: [escritorioId], references: [id])
  escritorioId String

  exercicios       Exercicio[]
  relatorios       Relatorio[]
  usuarios         Usuario[]
  vigenciasNcm     VigenciaNcm[]
  pagamentosEcac   EcacPagamento[]
  razaoLancamentos RazaoLancamento[]
  razaoImportacoes RazaoImportacao[]
  spedApuracoes    SpedApuracao[]
  spedImportacoes  SpedImportacao[]
  giamApuracoes    GiamApuracao[]
  giamImportacoes  GiamImportacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Exercício (ano-base) — demonstrativos estruturados em JSON.
// ---------------------------------------------------------------------------
model Exercicio {
  id         String  @id @default(cuid())
  ano        Int
  // JSON serializado de DemonstrativosExercicio (balanco + dre).
  dadosJson  String
  documentos String? // JSON: lista de documentos fornecidos

  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clienteId, ano])
}

// ---------------------------------------------------------------------------
// Relatório técnico gerado.
// status: EM_ANALISE | AGUARDANDO_REVISAO | APROVADO | LIBERADO
// ---------------------------------------------------------------------------
model Relatorio {
  id                 String  @id @default(cuid())
  titulo             String  @default("Relatório de Análise Financeira e Contábil")
  periodo            String // ex.: "2023 a 2024"
  status             String  @default("EM_ANALISE")
  situacao           String? // favoravel | regular_com_atencao | critica | inconclusiva
  bloqueado          Boolean @default(false)
  // Snapshot completo do resultado da análise + texto do relatório (JSON).
  conteudoJson       String
  origemTexto        String? // ia | deterministico
  observacaoIA       String?
  comentarioContador String?

  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String

  criadoPor   String?
  aprovadoPor String?
  aprovadoEm  DateTime?
  liberadoEm  DateTime?

  // Token do link rastreável (compartilhamento externo).
  shareToken String?           @unique
  acessos    AcessoRelatorio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Trilha de acessos a um relatório (rastreio): cada abertura/download do
// link rastreável é registrada — inclusive por quem recebeu por encaminhamento.
// ---------------------------------------------------------------------------
model AcessoRelatorio {
  id          String    @id @default(cuid())
  relatorio   Relatorio @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
  relatorioId String
  tipo        String // ABERTURA | DOWNLOAD
  ip          String?
  userAgent   String?
  dispositivo String? // resumo legível (navegador/SO)
  referer     String?
  createdAt   DateTime  @default(now())

  @@index([relatorioId])
}

// ---------------------------------------------------------------------------
// Registro de acessos e alterações (LGPD / auditoria).
// ---------------------------------------------------------------------------
model LogAcesso {
  id        String   @id @default(cuid())
  acao      String
  detalhe   String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId String?
  createdAt DateTime @default(now())
}

// ===========================================================================
// MÓDULO DE TRIBUTAÇÃO NCM (PIS/COFINS) — cadastros e cache
// ===========================================================================

// ---------------------------------------------------------------------------
// Configuração de tributação NCM. Ex: "ALIQUOTA ZERO - 109" (código 1),
// "MONOFASICO - 202" (código 32), "Tributacao Normal - 0" (código 55).
// Compartilhada entre todos os escritórios (base seed do Autmais + as novas).
// ---------------------------------------------------------------------------
model ConfiguracaoNcm {
  id           String        @id @default(cuid())
  codigo       Int           @unique // 1..N — bate com o código do TXT importado no Domínio
  descricao    String // ex: "ALIQUOTA ZERO - 109"
  tipo         String // aliquota_zero | monofasico | isenta | substituicao | suspensao | sem_incidencia | normal
  cstEntrada   String // ex: "73"
  cstSaida     String // ex: "6"
  natureza     String // ex: "109" (ou "0" pra tributação normal)
  origem       String        @default("seed_autmais") // seed_autmais | manual | econet
  ncmsBase     NcmBase[]
  ncmsVigencia NcmVigencia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Base de NCMs conhecidos — semente do arquivo pai da Autmais.
// Um mesmo NCM só pode estar em UMA configuração base (última classificação conhecida).
// ---------------------------------------------------------------------------
model NcmBase {
  ncm               String          @id // 8 dígitos numéricos, ex: "01051110"
  configuracao      ConfiguracaoNcm @relation(fields: [configuracaoId], references: [id])
  configuracaoId    String
  origem            String          @default("seed_autmais") // seed_autmais | econet_cache | manual
  atividadeContexto String? // varejo | atacado | fabricante — pra qual atividade essa classificação vale
  atualizadoEm      DateTime        @default(now())
}

// ---------------------------------------------------------------------------
// Vigência de tributação por cliente — equivalente ao "Vigência (1) TRIBUTAÇÃO"
// que o Domínio mostra na tela "Configurar Dados de Impostos por NCM/CEST".
// ---------------------------------------------------------------------------
model VigenciaNcm {
  id                 String   @id @default(cuid())
  cliente            Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId          String
  dataVigencia       DateTime // ex: 2025-01-01
  descricao          String   @default("TRIBUTAÇÃO")
  status             String   @default("EM_ELABORACAO") // EM_ELABORACAO | REVISADA | EXPORTADA
  // Caminho para o Excel de estoque salvo em Z:\ — auditoria + reprocessamento
  arquivoEstoquePath String?
  arquivoEstoqueNome String?

  ncms NcmVigencia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId, dataVigencia])
}

// ---------------------------------------------------------------------------
// Associação NCM ↔ Configuração dentro de uma vigência de cliente.
// Uma linha por NCM da vigência (deduplicado).
// ---------------------------------------------------------------------------
model NcmVigencia {
  id             String          @id @default(cuid())
  vigencia       VigenciaNcm     @relation(fields: [vigenciaId], references: [id], onDelete: Cascade)
  vigenciaId     String
  ncm            String // 8 dígitos
  configuracao   ConfiguracaoNcm @relation(fields: [configuracaoId], references: [id])
  configuracaoId String
  origem         String // seed_autmais | econet_auto | manual
  observacao     String?

  createdAt DateTime @default(now())

  @@unique([vigenciaId, ncm]) // um NCM só uma vez por vigência
  @@index([vigenciaId])
}

// ---------------------------------------------------------------------------
// Cache de consultas Econet — não repete pesquisa do mesmo NCM/atividade.
// TTL: 30 dias (regenera quando ficar velho).
// ---------------------------------------------------------------------------
model CacheEconet {
  id          String  @id @default(cuid())
  ncm         String // 8 dígitos
  atividade   String // varejo | atacado | fabricante | importador
  tipo        String // tipo detectado (aliquota_zero | monofasico | ...)
  natureza    String?
  cstEntrada  String?
  cstSaida    String?
  abasHtml    String? // json com todas as abas + naturezas encontradas
  observacoes String? // notas do parser

  consultadoEm DateTime @default(now())

  @@unique([ncm, atividade])
  @@index([consultadoEm])
}

// ---------------------------------------------------------------------------
// PAGTOWEB / PAGAMENTOS71 (SERPRO Integra Contador) — documentos de arrecadação
// pagos no e-CAC por cada cliente. Serve de Coluna B da Auditoria Tributária.
// Um EcacPagamento = 1 DARF/DAS/GPS (identificado por numeroDocumento).
// Cada pagamento pode ter N EcacDesmembramento (uma sub-receita cada).
// ---------------------------------------------------------------------------
model EcacPagamento {
  id        String @id @default(cuid())
  clienteId String

  numeroDocumento String // nº de autenticação bancária (único por cliente)
  tipoCodigo      String // ex.: "4" (DARF), "5" (DAS), ...
  tipoDescricao   String
  referencia      String?

  periodoApuracao DateTime
  dataArrecadacao DateTime
  dataVencimento  DateTime

  // Receita principal do documento (código-mestre; o desdobramento vai em EcacDesmembramento)
  codigoReceitaPrincipal    String
  descricaoReceitaPrincipal String?

  valorTotal          Decimal
  valorPrincipal      Decimal
  valorMulta          Decimal?
  valorJuros          Decimal?
  valorSaldoTotal     Decimal?
  valorSaldoPrincipal Decimal?
  valorSaldoMulta     Decimal?
  valorSaldoJuros     Decimal?

  sincronizadoEm DateTime @default(now())

  cliente         Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  desmembramentos EcacDesmembramento[]

  @@unique([clienteId, numeroDocumento])
  @@index([clienteId, dataArrecadacao])
  @@index([clienteId, periodoApuracao])
}

model EcacDesmembramento {
  id          String @id @default(cuid())
  pagamentoId String

  sequencial        String
  codigoReceita     String
  descricaoReceita  String?
  extensaoCodigo    String?
  extensaoDescricao String?

  periodoApuracao DateTime
  dataVencimento  DateTime

  valorTotal          Decimal
  valorPrincipal      Decimal
  valorMulta          Decimal?
  valorJuros          Decimal?
  valorSaldoTotal     Decimal?
  valorSaldoPrincipal Decimal?
  valorSaldoMulta     Decimal?
  valorSaldoJuros     Decimal?

  cib String?

  pagamento EcacPagamento @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)

  @@index([pagamentoId])
  @@index([codigoReceita, periodoApuracao])
}

// Log de sincronizações e-CAC — rastreia quando/quanto foi buscado por cliente/período.
// É o "relatório de sincronização" oficial. Serve tanto para idempotência
// (skip se já rodou hoje com sucesso pro mesmo range) quanto para auditoria.
model EcacSincronizacao {
  id        String @id @default(cuid())
  clienteId String

  tipo           String // DIARIO | MENSAL | MANUAL — DIARIO = 22h, MENSAL = dia 1, MANUAL = botão da UI
  periodoInicial DateTime // dataArrecadacao inicial da consulta
  periodoFinal   DateTime
  quantidade     Int      @default(0) // nº de documentos importados
  sucesso        Boolean  @default(true)
  mensagem       String? // erro (se sucesso=false) ou nota de sucesso

  executadoEm DateTime @default(now())

  @@index([clienteId, executadoEm])
  @@index([clienteId, tipo, periodoInicial, periodoFinal])
}

// ---------------------------------------------------------------------------
// RAZÃO CONTÁBIL (Coluna A da Auditoria Tributária) — lançamentos importados
// de xlsx exportado pelo sistema contábil do escritório (Domínio, Contmatic,
// Alterdata, etc). Parser genérico detecta colunas por heurística.
//
// Chave de conciliação com EcacPagamento: codigoReceita + numeroDocumento.
// ---------------------------------------------------------------------------
model RazaoLancamento {
  id        String @id @default(cuid())
  clienteId String

  // Identificação do tributo/documento
  codigoReceita    String // ex.: "2089" (IRPJ), "8109" (PIS)
  numeroDocumento  String? // nº autenticação bancária — chave de conciliação com e-CAC
  descricaoReceita String? // ex.: "IRPJ - Lucro Presumido"

  // Contábil
  contaContabil String? // ex.: "2.03.001 - IRPJ a Recolher"
  historico     String? // texto do lançamento

  // Valores
  valorPrincipal Decimal
  valorMulta     Decimal?
  valorJuros     Decimal?
  valorTotal     Decimal // principal + multa + juros (calculado no import)

  // Datas
  dataLancamento  DateTime // data em que foi lançado no razão
  periodoApuracao DateTime? // mês/ano da apuração do tributo (se informado)

  // Origem da importação (rastreabilidade)
  importacaoId String

  cliente    Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  importacao RazaoImportacao @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([clienteId, codigoReceita, numeroDocumento])
  @@index([clienteId, periodoApuracao])
  @@index([importacaoId])
}

// Log de importações do razão xlsx (rastreio + repetibilidade).
model RazaoImportacao {
  id        String @id @default(cuid())
  clienteId String

  nomeArquivo       String
  tamanhoBytes      Int     @default(0)
  totalLinhas       Int     @default(0) // linhas lidas do xlsx
  linhasImportadas  Int     @default(0) // linhas viáveis (com código+valor)
  linhasIgnoradas   Int     @default(0) // linhas sem dado suficiente
  sucesso           Boolean @default(true)
  mensagem          String? // erro ou nota
  colunasDetectadas String? // JSON: quais colunas do xlsx foram usadas pra cada campo

  importadoEm  DateTime @default(now())
  importadoPor String? // userId

  cliente     Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  lancamentos RazaoLancamento[]

  @@index([clienteId, importadoEm])
}

// ---------------------------------------------------------------------------
// SPED-Fiscal EFD ICMS/IPI — apuração do ICMS por competência (registro E110).
//
// Uma apuração por competência (mês). Layout oficial: Guia Prático da EFD
// ICMS/IPI da RFB. V1 do parser lê só o E110 (apuração ICMS operações próprias);
// registros complementares (C100, C170, E116 etc.) podem entrar em v2 se
// precisarmos detalhar por CFOP/nota fiscal.
//
// Uso: coluna A ("SPED-Fiscal") da matriz de Auditoria Fiscal ICMS pra
// clientes Real/Presumido a partir de 01/2026.
// ---------------------------------------------------------------------------
model SpedApuracao {
  id        String @id @default(cuid())
  clienteId String

  // Período de apuração (do registro E100)
  periodoApuracao DateTime // primeiro dia do mês de apuração
  dataInicial     DateTime
  dataFinal       DateTime

  // Valores do E110 (todos em BRL). Decimal preserva a precisão do arquivo.
  totalDebitos         Decimal // VL_TOT_DEBITOS (débito das saídas)
  totalCreditos        Decimal // VL_TOT_CREDITOS (crédito das entradas)
  saldoDevedorApurado  Decimal // VL_SLD_APURADO (0 quando cred > deb)
  deducoes             Decimal // VL_TOT_DED
  icmsARecolher        Decimal // VL_ICMS_RECOLHER (o valor efetivo a pagar)
  saldoCredorTransp    Decimal // VL_SLD_CREDOR_TRANSPORTAR (quando cred > deb)

  // Ajustes e estornos — guardados para auditoria mas não usados no confronto v1
  ajustesDebitos       Decimal @default(0) // VL_AJ_DEBITOS
  totalAjustesDebitos  Decimal @default(0) // VL_TOT_AJ_DEBITOS
  estornosCreditos     Decimal @default(0) // VL_ESTORNOS_CRED
  ajustesCreditos      Decimal @default(0) // VL_AJ_CREDITOS
  totalAjustesCreditos Decimal @default(0) // VL_TOT_AJ_CREDITOS
  estornosDebitos      Decimal @default(0) // VL_ESTORNOS_DEB
  saldoCredorAnterior  Decimal @default(0) // VL_SLD_CREDOR_ANT
  debitoEspecial       Decimal @default(0) // DEB_ESP

  // Totais de operações extraídos do bloco C (registros C100 regulares — COD_SIT=00).
  // Compras = notas com IND_OPER=0 (entrada); Vendas = IND_OPER=1 (saída).
  totalCompras     Decimal @default(0)
  totalVendas      Decimal @default(0)
  qtdNotasCompras  Int     @default(0)
  qtdNotasVendas   Int     @default(0)

  importacaoId String

  cliente    Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  importacao SpedImportacao @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, periodoApuracao]) // uma apuração por cliente/competência (reimport substitui)
  @@index([clienteId, periodoApuracao])
  @@index([importacaoId])
}

// Log de importações do arquivo SPED-Fiscal (rastreio + repetibilidade).
// NÃO armazena o arquivo em si — apenas metadados + hash pra deduplicação.
model SpedImportacao {
  id        String @id @default(cuid())
  clienteId String

  nomeArquivo         String
  tamanhoBytes        Int     @default(0)
  hashArquivo         String? // SHA-256 do conteúdo — permite deduplicar em varreduras futuras
  origem              String  @default("UPLOAD") // UPLOAD | VARREDURA_PASTA
  caminhoOrigem       String? // path absoluto (só quando VARREDURA_PASTA — pra rastrear de onde veio)
  totalLinhas         Int     @default(0) // linhas totais do arquivo
  registrosE110       Int     @default(0) // quantas apurações extraídas
  apuracoesGravadas   Int     @default(0) // quantas efetivamente gravadas
  apuracoesSubstituidas Int   @default(0) // quantas eram reimport (mesmo cliente+competência)
  sucesso             Boolean @default(true)
  mensagem            String? // erro ou nota

  // Metadados do arquivo (do registro 0000, se disponível)
  cnpjArquivo   String? // CNPJ do declarante conforme está no SPED
  ieArquivo     String? // Inscrição Estadual conforme está no SPED
  uf            String? // UF conforme está no SPED
  dataInicioArq DateTime? // DT_INI do 0000
  dataFimArq    DateTime? // DT_FIN do 0000

  importadoEm  DateTime @default(now())
  importadoPor String? // userId

  cliente   Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  apuracoes SpedApuracao[]

  @@index([clienteId, importadoEm])
  @@index([clienteId, hashArquivo])
}

// ---------------------------------------------------------------------------
// GIAM 10.0 — Apuração ICMS declarada à SEFAZ-TO (uma por competência/revisão).
//
// Segmento A do arquivo GIAM traz tudo consolidado: débito das saídas, crédito
// das entradas, saldo credor anterior, deduções, etc. Segmento E traz o ICMS a
// recolher por tipo (Normal, ST, Diferencial, etc — pode ter várias linhas E).
//
// Uso: coluna A ("GIAM") da matriz de Auditoria de Obrigações Acessórias. Pra
// Simples Nacional é a fonte principal (SPED-Fiscal desobrigado). Pra Real/
// Presumido ≤ 12/2025, fonte histórica.
// ---------------------------------------------------------------------------
model GiamApuracao {
  id        String @id @default(cuid())
  clienteId String

  periodoApuracao DateTime // primeiro dia do mês
  retificacao     String   @default("00") // do campo A4 (00 = original)

  // Segmento A — apuração consolidada (todos em BRL)
  debitoSaidas         Decimal // A18
  outrosDebitos        Decimal @default(0) // A19
  estornoCreditos      Decimal @default(0) // A20
  creditoEntradas      Decimal // A21
  outrosCreditos       Decimal @default(0) // A22
  estornosDebito       Decimal @default(0) // A23
  saldoCredorAnterior  Decimal @default(0) // A24
  deducoes             Decimal @default(0) // A25
  difAliquotaARecolher Decimal @default(0) // A26

  // Totais consolidados do Segmento B — o que aparece nas linhas "TOTAL" do
  // Quadro 4 do Espelho da GIAM. Somam TODAS as linhas do lado (entrada ou
  // saída). Ficam gravados aqui pra evitar SUM em runtime na tela de confronto.
  // O detalhamento CFOP a CFOP fica em GiamLinhaSegmentoB.
  //
  // Entradas
  totalEntradasBaseCalculo      Decimal @default(0) // Σ B7 onde B5=0
  totalEntradasIsentas          Decimal @default(0) // Σ B8 onde B5=0
  totalEntradasOutras           Decimal @default(0) // Σ B9 onde B5=0
  totalEntradasST               Decimal @default(0) // Σ B10 onde B5=0
  totalEntradasValorContabil    Decimal @default(0) // Σ B11 onde B5=0 (= totalCompras, mantido pra compat)
  totalEntradasCredito          Decimal @default(0) // Σ B12 onde B5=0
  // Saídas
  totalSaidasBaseCalculo        Decimal @default(0) // Σ B7 onde B5=1
  totalSaidasIsentas            Decimal @default(0) // Σ B8 onde B5=1
  totalSaidasOutras             Decimal @default(0) // Σ B9 onde B5=1
  totalSaidasST                 Decimal @default(0) // Σ B10 onde B5=1
  totalSaidasValorContabil      Decimal @default(0) // Σ B11 onde B5=1 (= totalVendas, mantido pra compat)
  totalSaidasDebito             Decimal @default(0) // Σ B12 onde B5=1

  // Compat: preserva o campo antigo (mesmo valor de totalEntradasValorContabil / totalSaidasValorContabil).
  totalCompras Decimal @default(0)
  totalVendas  Decimal @default(0)

  // Segmento E — ICMS a recolher (consolidado somando todos os tipos).
  // Pra detalhe por tipo, ver GiamIcmsARecolher (relação).
  icmsARecolherTotal Decimal @default(0)

  // Segmento Z (rastreio)
  totalRegistros Int @default(0)

  importacaoId String

  cliente          Cliente              @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  importacao       GiamImportacao       @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  icmsARecolher    GiamIcmsARecolher[]
  linhasSegmentoB  GiamLinhaSegmentoB[]

  @@unique([clienteId, periodoApuracao, retificacao])
  @@index([clienteId, periodoApuracao])
  @@index([importacaoId])
}

// Segmento B — uma linha por CFOP × natureza. Espelha o Quadro 4 do PDF da
// SEFAZ ("Entradas/Aquisições" e "Saídas/Prestações" com colunas Valor
// Contábil / Base Cálculo / Crédito ou Débito / Isentas / Outras / ST).
// Recriado a cada re-import da apuração.
model GiamLinhaSegmentoB {
  id         String @id @default(cuid())
  apuracaoId String

  natureza             String  // "0" = entrada, "1" = saída
  cfop                 String  // 4 dígitos (B6)
  baseCalculo          Decimal @default(0)
  isentasNaoTributadas Decimal @default(0)
  outras               Decimal @default(0)
  substituicaoTributaria Decimal @default(0)
  valorContabil        Decimal @default(0)
  creditoDebitoImposto Decimal @default(0) // crédito se entrada, débito se saída
  domicilioFiscal      String  // "A" ou "B"

  apuracao GiamApuracao @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)

  @@index([apuracaoId])
  @@index([apuracaoId, natureza, cfop])
}

// Segmento E do GIAM — pode ter múltiplas linhas (uma por tipo de ICMS).
model GiamIcmsARecolher {
  id           String @id @default(cuid())
  apuracaoId   String

  tipo         String   // N=Normal, D=Dif.Alíq.Entradas, S=ST, C=Complementação, F=Dif.Alíq.Saídas, P=FundoPobreza
  dataVencimento DateTime?
  valor        Decimal

  apuracao GiamApuracao @relation(fields: [apuracaoId], references: [id], onDelete: Cascade)

  @@index([apuracaoId])
}

// Log de importações de arquivo GIAM (mesma filosofia do SpedImportacao).
model GiamImportacao {
  id        String @id @default(cuid())
  clienteId String

  nomeArquivo       String
  tamanhoBytes      Int     @default(0)
  hashArquivo       String? // SHA-256
  origem            String  @default("UPLOAD") // UPLOAD | VARREDURA_PASTA
  caminhoOrigem     String?
  sucesso           Boolean @default(true)
  mensagem          String?

  // Metadados extraídos do Segmento A
  ieArquivo         String? // IE dentro do arquivo (pra sanity check com Cliente.inscricaoEstadual)
  periodoArquivo    String? // MMAAAA
  retificacaoArquivo String? // do campo A4
  versaoArquivo     String? // A33 (=10.00)
  nomeContabilista  String? // A16
  crcContabilista   String? // A14 + A15

  importadoEm  DateTime @default(now())
  importadoPor String?

  cliente   Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  apuracoes GiamApuracao[]

  @@index([clienteId, importadoEm])
  @@index([clienteId, hashArquivo])
}
